# TraceSleuth Environment Configuration

# Environment mode: development, staging, production
TRACESLEUTH_ENV=development
TRACESLEUTH_APP_VERSION=0.1.0
TRACESLEUTH_MODEL_CONFIG_VERSION=v1.0.0
TRACESLEUTH_PROMPT_VERSION=v1.2.0

# Telemetry & Privacy Policy
# In accordance with OpenTelemetry GenAI standards and data privacy,
# raw prompt/output capture is disabled by default.
TRACESLEUTH_CAPTURE_RAW_CONTENT=false
TRACESLEUTH_ENABLE_REDACTION=true

# Telemetry Exporters (console, memory, file, otlp)
TRACESLEUTH_EXPORTER=file
TRACESLEUTH_TRACE_DIR=./fixtures/traces

# Storage Configuration (PostgreSQL / SQLite for future milestones)
TRACESLEUTH_DB_URL=sqlite:///./tracesleuth.db
